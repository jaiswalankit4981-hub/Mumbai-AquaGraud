# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5000

# Database
MONGO_URI=mongodb+srv://jaiswalankit4981_db_user:BmmYxF2TGiISUGkO@cluster0.tm98o2r.mongodb.net/aquaguard?appName=Cluster0

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Device ingestion (ESP32 sends this in the x-api-key header)
SENSOR_API_KEY=aquaguard-device-key-001

# Thresholds (cm) - FR-05
WATER_WARNING_CM=5
WATER_LOGGED_CM=15
WATER_CRITICAL_CM=30
# Rate of rise that counts as "rising fast" (cm per minute) - FR-06
RAPID_RISE_CM_PER_MIN=1.5
# Sensor offline detection (minutes) - FR-38
SENSOR_OFFLINE_MINUTES=10
# Hazard buffer used by the route engine (metres) - FR-17
HAZARD_BUFFER_M=120
# Duplicate citizen report grouping (metres / hours) - FR-15
DUPLICATE_RADIUS_M=150
DUPLICATE_WINDOW_HOURS=6

# Optional MQTT broker
MQTT_ENABLED=false
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=aquaguard/+/reading

# Routing engine (public OSRM demo server)
OSRM_URL=https://router.project-osrm.org
